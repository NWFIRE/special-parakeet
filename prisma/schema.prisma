
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  INTERNAL
  CUSTOMER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ReportStatus {
  DRAFT
  ISSUED
  INVOICED
  ARCHIVED
}

enum InspectionServiceType {
  FIRE_EXTINGUISHER
  KITCHEN_SUPPRESSION
  FIRE_ALARM
  EMERGENCY_EXIT_LIGHTING
  FIRE_SPRINKLER
  BACKFLOW
  OTHER
}

enum InspectionOutcome {
  PASS
  ATTENTION
  FAIL
  NOT_APPLICABLE
}

enum AutofillSourceType {
  ASSET_RECORD
  PREVIOUS_REPORT
  SITE_DEFAULT
  TEAM_PROFILE
  TEMPLATE
  MANUAL
}

model User {
  id               String                 @id @default(cuid())
  name             String?
  email            String                 @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  userType         UserType               @default(INTERNAL)
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  invites          Invite[]               @relation("InviteSender")
  assignedTasks    Task[]                 @relation("TaskAssignee")
  inspectionAudits InspectionFieldAudit[] @relation("InspectionAuditUser")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Client {
  id           String             @id @default(cuid())
  teamId       String
  companyName  String
  contactName  String?
  contactEmail String?
  contactPhone String?
  siteCount    Int?
  notes        String?
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  users        User[]
  reports      InspectionReport[]
  sites        ClientSite[]
  assets       InspectionAsset[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([teamId, companyName])
}

model ClientSite {
  id             String             @id @default(cuid())
  teamId         String
  clientId       String
  name           String
  siteCode       String?
  addressLine1   String
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  reportDefaults Json?
  team           Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reports        InspectionReport[]
  assets         InspectionAsset[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([teamId, clientId, name])
}

model InspectionAsset {
  id                    String                 @id @default(cuid())
  teamId                String
  clientId              String
  siteId                String
  serviceType           InspectionServiceType
  name                  String
  location              String?
  assetTag              String?
  deviceType            String?
  manufacturer          String?
  model                 String?
  serialNumber          String?
  ulListing             String?
  complianceFrequency   String?
  installDate           DateTime?
  lastServiceDate       DateTime?
  nextServiceDate       DateTime?
  defaultCodeReferences Json?
  profileData           Json?
  lastInspectionData    Json?
  active                Boolean                @default(true)
  team                  Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site                  ClientSite             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reportAssets          InspectionReportAsset[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([teamId, serviceType, name])
  @@index([siteId, serviceType])
}
model InspectionReport {
  id                      String                 @id @default(cuid())
  teamId                  String
  clientId                String
  siteId                  String?
  title                   String
  reportNumber            String?
  inspectionType          String
  serviceType             InspectionServiceType
  status                  ReportStatus           @default(DRAFT)
  overallStatus           InspectionOutcome      @default(PASS)
  propertyName            String
  propertyAddress         String?
  inspectorName           String?
  pointOfContact          String?
  frequencyLabel          String?
  serviceDate             DateTime               @default(now())
  completedAt             DateTime?
  nextInspectionDate      DateTime?
  summary                 String?
  recommendationSummary   String?
  notes                   String?
  codeReferences          Json?
  checklistItems          Json?
  deficiencies            Json?
  equipmentSummary        Json?
  technicianLicense       String?
  technicianCertification String?
  customerSignature       Json?
  technicianSignature     Json?
  photoUrls               Json?
  autoFillSummary         Json?
  pdfUrl                  String?
  finalizedAt             DateTime?
  portalPublishedAt       DateTime?
  team                    Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site                    ClientSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assets                  InspectionReportAsset[]
  audits                  InspectionFieldAudit[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([teamId, status, completedAt])
  @@index([clientId, status, completedAt])
  @@index([siteId, serviceType, completedAt])
}

model InspectionReportAsset {
  id                  String                 @id @default(cuid())
  reportId            String
  assetId             String?
  sortOrder           Int                    @default(0)
  assetName           String
  location            String?
  assetTag            String?
  deviceType          String?
  manufacturer        String?
  model               String?
  serialNumber        String?
  ulListing           String?
  complianceFrequency String?
  lastServiceDate     DateTime?
  nextServiceDate     DateTime?
  status              InspectionOutcome      @default(PASS)
  deficiencySummary   String?
  recommendationText  String?
  followUpRequired    Boolean                @default(false)
  attributes          Json?
  testResults         Json?
  codeReferences      Json?
  appliedTemplateKeys Json?
  autofillMeta        Json?
  report              InspectionReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  asset               InspectionAsset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  audits              InspectionFieldAudit[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([reportId, sortOrder])
  @@index([assetId, status])
}

model InspectionFieldAudit {
  id            String                 @id @default(cuid())
  reportId      String
  reportAssetId String?
  changedById   String?
  fieldPath     String
  sourceType    AutofillSourceType
  sourceLabel   String?
  sourceValue   String?
  finalValue    String?
  wasOverridden Boolean                @default(false)
  report        InspectionReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportAsset   InspectionReportAsset? @relation(fields: [reportAssetId], references: [id], onDelete: Cascade)
  changedBy     User?                  @relation("InspectionAuditUser", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())

  @@index([reportId, createdAt])
  @@index([reportAssetId, fieldPath])
}

model TeamProfile {
  id                String   @id @default(cuid())
  teamId            String   @unique
  companyName       String?
  logoUrl           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  phone             String?
  email             String?
  website           String?
  licenseNumbers    Json?
  certificationText String?
  reportDisclaimer  String?
  footerText        String?
  primaryColor      String?
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model Team {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  memberships  Membership[]
  projects     Project[]
  invites      Invite[]
  tasks        Task[]
  clients      Client[]
  sites        ClientSite[]
  assets       InspectionAsset[]
  reports      InspectionReport[]
  profile      TeamProfile?
  subscription Subscription?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  userId    String
  teamId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, teamId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  teamId      String
  projectId   String
  assigneeId  String?
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invite {
  id          String         @id @default(cuid())
  email       String
  role        MembershipRole @default(MEMBER)
  token       String         @unique
  teamId      String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([email, teamId])
}

model Subscription {
  id                   String             @id @default(cuid())
  teamId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  team                 Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}
