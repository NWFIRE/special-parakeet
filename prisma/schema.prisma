generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  INTERNAL
  CUSTOMER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ReportStatus {
  DRAFT
  ISSUED
  INVOICED
  ARCHIVED
}

enum InspectionServiceType {
  FIRE_EXTINGUISHER
  KITCHEN_SUPPRESSION
  FIRE_ALARM
  EMERGENCY_EXIT_LIGHTING
  FIRE_SPRINKLER
  BACKFLOW
  OTHER
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  userType      UserType     @default(INTERNAL)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  invites       Invite[]     @relation("InviteSender")
  assignedTasks Task[]       @relation("TaskAssignee")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Client {
  id            String             @id @default(cuid())
  teamId        String
  companyName   String
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  siteCount     Int?
  notes         String?
  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  users         User[]
  reports       InspectionReport[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([teamId, companyName])
}

model InspectionReport {
  id                 String                @id @default(cuid())
  teamId             String
  clientId           String
  title              String
  reportNumber       String?
  serviceType        InspectionServiceType
  status             ReportStatus          @default(DRAFT)
  propertyName       String
  propertyAddress    String?
  inspectorName      String?
  pointOfContact     String?
  frequencyLabel     String?
  completedAt        DateTime?
  nextInspectionDate DateTime?
  notes              String?
  checklistItems     Json?
  deficiencies       Json?
  equipmentSummary   Json?
  pdfUrl             String?
  team               Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([teamId, status, completedAt])
  @@index([clientId, status, completedAt])
}

model Team {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  memberships  Membership[]
  projects     Project[]
  invites      Invite[]
  tasks        Task[]
  clients      Client[]
  reports      InspectionReport[]
  subscription Subscription?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(MEMBER)
  userId    String
  teamId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, teamId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  teamId      String
  projectId   String
  assigneeId  String?
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invite {
  id          String         @id @default(cuid())
  email       String
  role        MembershipRole @default(MEMBER)
  token       String         @unique
  teamId      String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([email, teamId])
}

model Subscription {
  id                   String             @id @default(cuid())
  teamId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  team                 Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}


